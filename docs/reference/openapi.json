            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "LinkIn": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "LinkIn",
        "type": "object"
      },
      "MePatch": {
        "properties": {
          "tz": {
            "title": "Tz",
            "type": "string"
          }
        },
        "required": [
          "tz"
        ],
        "title": "MePatch",
        "type": "object"
      },
