          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "tz": {
            "title": "Tz",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
