            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskIn",
        "type": "object"
      },
      "Caps": {
        "properties": {
          "cap_today": {
            "title": "Cap Today",
            "type": "number"
          },
          "spent_today": {
            "title": "Spent Today",
            "type": "number"
          }
        },
        "required": [
          "spent_today",
          "cap_today"
        ],
        "title": "Caps",
        "type": "object"
      },
      "FeedbackIn": {
        "properties": {
