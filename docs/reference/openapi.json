            "title": "Init Data",
            "type": "string"
          }
        },
        "required": [
          "init_data"
        ],
        "title": "TelegramIn",
        "type": "object"
      },
      "TelegramOut": {
        "properties": {
          "bearer": {
            "title": "Bearer",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "bearer",
          "user"
        ],
        "title": "TelegramOut",
        "type": "object"
