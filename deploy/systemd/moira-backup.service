[Unit]
Description=Moira nightly encrypted backup (blueprint §13.14)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=moira
WorkingDirectory=/opt/moira/current/backend
EnvironmentFile=/etc/moira/env
ExecStart=/opt/moira/current/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/moira
