# Moira configuration. Copy to backend/.env for local dev; production uses /etc/moira/env.
# Every variable from blueprint Appendix A. Fake values only; never commit real ones.

# dev, test or prod. test forces FakeLLM and FixedClock hooks. (required: yes)
APP_ENV=dev

# e.g. https://moira.duckdns.org; used in links, Mini App URLs, CSP checks (required: yes)
PUBLIC_BASE_URL=http://localhost:5173

# Root of all databases (§5.7) (required: yes)
DATA_DIR=../.data

# DEBUG only in dev with synthetic data (required: no)
LOG_LEVEL=INFO

# Time zone for new users (required: no)
DEFAULT_TZ=Asia/Kathmandu

# Production or dev bot token (never the same token in two places) (required: yes)
TELEGRAM_BOT_TOKEN=123456:replace-with-your-DEV-bot-token

# Without @; used for deep links (required: yes)
TELEGRAM_BOT_USERNAME=moira_dev_bot

# Numeric id of the owner; gets digests, alerts, /stats (required: yes)
OWNER_TELEGRAM_ID=1000001

# Meta Model API key (required: yes (prod))
# MODEL_API_KEY=

# Meta API base URL (required: no)
MODEL_API_BASE=https://api.meta.ai/v1

# Standard-mode model for real data (required: no)
MODEL_MAIN=muse-spark-1.3

# Synthetic demo data and eval only (required: no)
MODEL_CONTRIB=muse-spark-1.3-contributor

# Transcription model (required: no)
MODEL_ASR=muse-voice-transcribe-1.0

# responses or chat (§9.2) (required: no)
STRUCTURED_TRANSPORT=responses

# Kill switch: false = degraded mode everywhere, capture continues (required: no)
AI_ENABLED=true

# model2vec model id (required: no)
EMBED_MODEL=minishlab/potion-retrieval-32M

# Vector dimension (must match meta.embed_dim) (required: no)
EMBED_DIM=256

# model2vec quantize_to (required: no)
EMBED_QUANTIZE=int8

# Model cache location (required: no)
# HF_HOME=$DATA_DIR/models

# Never download at startup (required: no)
# HF_HUB_OFFLINE=1` in prod

# §9.6 (required: no)
CAP_GLOBAL_DAILY_USD=3.00

# §9.6 (required: no)
CAP_OWNER_DAILY_USD=1.50

# §9.6 (required: no)
CAP_TESTER_DAILY_USD=0.30

# §9.6 (required: no)
CAP_JUDGE_DAILY_USD=0.40

# §9.6 (required: no)
CAP_SANDBOX_DAILY_USD=0.10

# §9.6 (required: no)
CAP_WEB_SEARCHES_DAILY=150

# §9.6 (required: no)
CAP_VIDEO_DAILY=10

# §9.6 lifetime (required: no)
CAP_TOTAL_USD=120

# §7.0 (required: no)
WORKER_CONCURRENCY=3

# §11.4 (required: no)
SANDBOX_TTL_HOURS=24

# §11.4 (required: no)
SANDBOX_MAX_ACTIVE=200

# §10.1 (required: no)
SANDBOX_CREATE_PER_IP_HOUR=5

# Judge accounts expire after this date (the community vote ends 16 Nov) (required: no)
JUDGE_ACCESS_UNTIL=2026-11-20

# Rolling session lifetime (required: no)
SESSION_DAYS=90

# Login link lifetime (required: no)
LOGIN_TOKEN_MINUTES=10

# Fine-grained token, no scopes; raises GitHub rate limits (required: no)
# GITHUB_TOKEN=

# Owner digest time (owner's time zone) (required: no)
DIGEST_LOCAL_TIME=08:00

# Nightly job time per memory (user's time zone) (required: no)
NIGHTLY_LOCAL_TIME=03:30

# age1… public key (backup script) (required: yes (prod))
# BACKUP_AGE_RECIPIENT=

# e.g. oci:moira-backups (backup script) (required: yes (prod))
# BACKUP_RCLONE_REMOTE=

# Retention (required: no)
BACKUP_KEEP_DAILY=14

# Retention (required: no)
BACKUP_KEEP_WEEKLY=8

# Used only by the DuckDNS timer (/etc/moira/duckdns.env) (required: prod)
# DUCKDNS_DOMAIN=

# Used only by the DuckDNS timer (/etc/moira/duckdns.env) (required: prod)
# DUCKDNS_TOKEN=

# Hostname for Caddy (systemd drop-in for caddy.service) (required: prod)
# MOIRA_HOST=
